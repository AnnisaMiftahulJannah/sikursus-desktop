	<parameter name="P_ID_PENDAFTARAN" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
    p.id_pendaftaran,
    p.tanggal_daftar,
    p.status AS status_pendaftaran,
    ps.nim,
    ps.nama AS nama_peserta,
    ps.prodi,
    ps.no_hp,
    k.nama_kelas,
    kr.kode_kursus,
    kr.nama_kursus,
    kr.level,
    kr.biaya,
    i.nama AS nama_instruktur
FROM pendaftaran p
JOIN peserta ps ON p.id_peserta = ps.id_peserta
JOIN kelas k ON p.id_kelas = k.id_kelas
JOIN kursus kr ON k.id_kursus = kr.id_kursus
LEFT JOIN instruktur i ON k.id_instruktur = i.id_instruktur
WHERE ($P{P_ID_PENDAFTARAN} IS NULL OR $P{P_ID_PENDAFTARAN} <= 0 OR p.id_pendaftaran = $P{P_ID_PENDAFTARAN})
ORDER BY p.id_pendaftaran ASC;]]>
	</queryString>
